rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.email is string && data.email.size() > 0 &&
             data.uid == request.auth.uid;
    }

    function isValidAnime(data) {
      return data.keys().hasAll(['titleUa', 'posterUrl']) &&
             data.titleUa is string && data.titleUa.size() <= 200 &&
             data.posterUrl is string && data.posterUrl.size() <= 500;
    }

    function isValidEpisode(data) {
      return data.keys().hasAll(['number']) &&
             data.number is int;
    }

    function isValidWatchHistory(data) {
      return data.keys().hasAll(['animeId', 'episodeId', 'lastWatchedAt']) &&
             data.animeId is string && data.episodeId is string &&
             data.lastWatchedAt == request.time;
    }

    // --- Collection Matches ---

    // Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Users shouldn't be listable by clients for PII safety
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // Anime (Publicly Readable)
    match /anime/{animeId} {
      allow read: if true;
      allow create: if true; // Allow anonymous seeding for initial population
      allow update, delete: if false;

      match /episodes/{episodeId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;

        match /voices/{voiceId} {
          allow read: if true;
          allow create: if true;
          allow update, delete: if false;
        }
      }
    }

    // User Data (History & Watchlist)
    match /users/{userId}/history/{historyId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidWatchHistory(incoming());
      allow update: if isOwner(userId) && isValidWatchHistory(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['progressSeconds', 'lastWatchedAt']);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/watchlist/{watchlistId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
  }
}
